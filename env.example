# Check Your Crypto - Environment Variables
# Скопируйте этот файл в .env и заполните значения

# Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here

# Database
DATABASE_URL=postgresql://username:password@your-prod-db-host:5432/checkyourcrypto

# MetaSleuth API
METASLEUTH_API_KEY=your_metasleuth_api_key_here
METASLEUTH_API_URL=https://api.metasleuth.io

# OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Monitoring (Optional)
SENTRY_DSN=your_sentry_dsn_here

# Payment (Optional)
BINANCE_PAY_API_KEY=your_binance_pay_api_key_here
BINANCE_PAY_SECRET=your_binance_pay_secret_here

# Environment
ENVIRONMENT=production
DEBUG=false
