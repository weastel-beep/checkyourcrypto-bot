[flake8]
max-line-length = 127
max-complexity = 10
ignore = 
    E203,
    W503,
    E501,
    F401,
exclude = 
    .git,
    __pycache__,
    venv,
    env,
    .venv,
    .env,
    migrations,
    alembic/versions,
    build,
    dist,
    *.egg-info,
    .pytest_cache,
    .tox,
    docs,
    backups
per-file-ignores =
    __init__.py:F401,F403
    */migrations/*:E501,F401
    tests/*:F401,F811
